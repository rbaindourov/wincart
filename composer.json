{
    "name": "rbaindourov/wincart",
    "description": "Modern PHP 8.x e-commerce platform designed to compete with WooCommerce, featuring native Model Context Protocol (MCP) server integration and rapid installer.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Robert Baindourov",
            "email": "rbaindourov@gmail.com",
            "role": "Lead Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "WinCart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WinCart\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite Unit,Feature",
        "test:unit": "phpunit --testsuite Unit",
        "test:feature": "phpunit --testsuite Feature",
        "test:e2e": "phpunit --testsuite E2E",
        "check-style": "phpcs --standard=PSR12 src/ tests/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
