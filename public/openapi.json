{
    "openapi": "3.0.3",
    "info": {
        "title": "winCart Headless REST API",
        "version": "1.0.0",
        "description": "Autonomous e-commerce engine API engineered for high-performance headless commerce and AI agents.",
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "contact": {
            "name": "winCart API Support",
            "email": "rbaindourov@gmail.com"
        }
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Local development server"
        },
        {
            "url": "/",
            "description": "Relative root server"
        }
    ],
    "paths": {
        "/api/v1/products": {
            "get": {
                "summary": "List products with filtering and pagination",
                "operationId": "listProducts",
                "parameters": [
                    {
                        "name": "query",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Search term for name, SKU, or description"
                    },
                    {
                        "name": "category_id",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        },
                        "description": "Filter by category ID"
                    },
                    {
                        "name": "category",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "Filter by category slug"
                    },
                    {
                        "name": "in_stock",
                        "in": "query",
                        "schema": {
                            "type": "boolean"
                        },
                        "description": "Filter in-stock products"
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "per_page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 20
                        }
                    },
                    {
                        "name": "offset",
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated product list",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ProductListResponse"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Create a new product",
                "operationId": "createProduct",
                "security": [
                    {
                        "bearerAuth": [
                            "products:write"
                        ]
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductInput"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Product created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/403Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/422ValidationError"
                    }
                }
            }
        },
        "/api/v1/products/{id_or_slug}": {
            "get": {
                "summary": "Get product by ID or slug",
                "operationId": "getProduct",
                "parameters": [
                    {
                        "name": "id_or_slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Product details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/404NotFound"
                    }
                }
            },
            "patch": {
                "summary": "Partially update product",
                "operationId": "patchProduct",
                "security": [
                    {
                        "bearerAuth": [
                            "products:write"
                        ]
                    }
                ],
                "parameters": [
                    {
                        "name": "id_or_slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ProductUpdateInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Updated product",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Product"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/403Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/404NotFound"
                    }
                }
            },
            "delete": {
                "summary": "Delete product",
                "operationId": "deleteProduct",
                "security": [
                    {
                        "bearerAuth": [
                            "products:write"
                        ]
                    }
                ],
                "parameters": [
                    {
                        "name": "id_or_slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Product deleted"
                    },
                    "401": {
                        "$ref": "#/components/responses/401Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/403Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/404NotFound"
                    }
                }
            }
        },
        "/api/v1/categories": {
            "get": {
                "summary": "List categories (flat or tree)",
                "operationId": "listCategories",
                "parameters": [
                    {
                        "name": "format",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "tree",
                                "flat"
                            ],
                            "default": "tree"
                        }
                    },
                    {
                        "name": "tree",
                        "in": "query",
                        "schema": {
                            "type": "boolean"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Category listings",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CategoryListResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/categories/{id_or_slug}": {
            "get": {
                "summary": "Get category details",
                "operationId": "getCategory",
                "parameters": [
                    {
                        "name": "id_or_slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Category details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Category"
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/404NotFound"
                    }
                }
            }
        },
        "/api/v1/cart": {
            "post": {
                "summary": "Initialize a new cart",
                "operationId": "initCart",
                "responses": {
                    "201": {
                        "description": "Cart initialized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CartInitResponse"
                                }
                            }
                        }
                    }
                }
            },
            "get": {
                "summary": "Get current cart and calculated totals",
                "operationId": "getCart",
                "responses": {
                    "200": {
                        "description": "Current cart contents",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Cart"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/cart/items": {
            "post": {
                "summary": "Add item to cart",
                "operationId": "addCartItem",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CartItemInput"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Item added",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Cart"
                                }
                            }
                        }
                    },
                    "409": {
                        "$ref": "#/components/responses/409Conflict"
                    },
                    "422": {
                        "$ref": "#/components/responses/422ValidationError"
                    }
                }
            }
        },
        "/api/v1/cart/items/{id}": {
            "patch": {
                "summary": "Update item quantity in cart",
                "operationId": "updateCartItem",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "quantity": {
                                        "type": "integer",
                                        "minimum": 0
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Item updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Cart"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "summary": "Remove item from cart",
                "operationId": "removeCartItem",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Item removed"
                    }
                }
            }
        },
        "/api/v1/cart/coupons": {
            "post": {
                "summary": "Apply coupon code to cart",
                "operationId": "applyCoupon",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "code"
                                ],
                                "properties": {
                                    "code": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Coupon applied",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "status": {
                                            "type": "string"
                                        },
                                        "coupon": {
                                            "type": "string"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400BadRequest"
                    }
                }
            }
        },
        "/api/v1/checkout": {
            "post": {
                "summary": "Submit order checkout",
                "operationId": "checkout",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CheckoutInput"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Order placed successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        }
                    },
                    "409": {
                        "$ref": "#/components/responses/409Conflict"
                    },
                    "422": {
                        "$ref": "#/components/responses/422ValidationError"
                    }
                }
            }
        },
        "/api/v1/orders": {
            "get": {
                "summary": "List customer or store orders",
                "operationId": "listOrders",
                "security": [
                    {
                        "bearerAuth": [
                            "orders:read"
                        ]
                    }
                ],
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "pending",
                                "processing",
                                "completed",
                                "cancelled",
                                "refunded"
                            ]
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 20
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Orders list",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OrderListResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/403Forbidden"
                    }
                }
            }
        },
        "/api/v1/orders/{id}": {
            "get": {
                "summary": "Get order details by ID",
                "operationId": "getOrder",
                "security": [
                    {
                        "bearerAuth": [
                            "orders:read"
                        ]
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Order details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/403Forbidden"
                    },
                    "404": {
                        "$ref": "#/components/responses/404NotFound"
                    }
                }
            }
        },
        "/api/v1/orders/{id}/status": {
            "patch": {
                "summary": "Update order status",
                "operationId": "updateOrderStatus",
                "security": [
                    {
                        "bearerAuth": [
                            "orders:write"
                        ]
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "status"
                                ],
                                "properties": {
                                    "status": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Status updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/403Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/422ValidationError"
                    }
                }
            }
        },
        "/api/v1/orders/{id}/refund": {
            "post": {
                "summary": "Refund order items",
                "operationId": "refundOrder",
                "security": [
                    {
                        "bearerAuth": [
                            "orders:write"
                        ]
                    }
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "reason": {
                                        "type": "string"
                                    },
                                    "restock": {
                                        "type": "boolean"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Order refunded",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Order"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/403Forbidden"
                    }
                }
            }
        },
        "/api/v1/admin/metrics": {
            "get": {
                "summary": "Get store performance metrics",
                "operationId": "getAdminMetrics",
                "security": [
                    {
                        "bearerAuth": [
                            "admin:read"
                        ]
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Store metrics",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StoreMetrics"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/403Forbidden"
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "PAT",
                "description": "Personal Access Token (PAT) with granular scopes: products:read, products:write, orders:read, orders:write, cart:read, admin:read, admin:write"
            }
        },
        "schemas": {
            "Product": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "sku": {
                        "type": "string"
                    },
                    "product_type": {
                        "type": "string"
                    },
                    "price": {
                        "type": "integer",
                        "description": "Amount in minor currency units (cents)"
                    },
                    "currency": {
                        "type": "string",
                        "default": "USD"
                    },
                    "stock_quantity": {
                        "type": "integer"
                    },
                    "stock_status": {
                        "type": "string",
                        "enum": [
                            "in_stock",
                            "out_of_stock",
                            "on_backorder"
                        ]
                    },
                    "is_active": {
                        "type": "boolean"
                    }
                }
            },
            "Category": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "slug": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string",
                        "nullable": true
                    },
                    "parent_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "children": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Category"
                        }
                    }
                }
            },
            "Cart": {
                "type": "object",
                "properties": {
                    "cart_token": {
                        "type": "string"
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CartItem"
                        }
                    },
                    "subtotal": {
                        "type": "integer"
                    },
                    "discount_amount": {
                        "type": "integer"
                    },
                    "discounted_subtotal": {
                        "type": "integer"
                    },
                    "tax_amount": {
                        "type": "integer"
                    },
                    "shipping_amount": {
                        "type": "integer"
                    },
                    "grand_total": {
                        "type": "integer"
                    },
                    "formatted_total": {
                        "type": "string"
                    }
                }
            },
            "CartItem": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "product_id": {
                        "type": "integer"
                    },
                    "variation_id": {
                        "type": "integer",
                        "nullable": true
                    },
                    "quantity": {
                        "type": "integer"
                    },
                    "unit_price": {
                        "type": "integer"
                    },
                    "line_total": {
                        "type": "integer"
                    }
                }
            },
            "Order": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "order_number": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "pending",
                            "processing",
                            "completed",
                            "cancelled",
                            "refunded"
                        ]
                    },
                    "grand_total": {
                        "type": "integer"
                    },
                    "currency": {
                        "type": "string"
                    },
                    "line_items": {
                        "type": "array",
                        "items": {
                            "type": "object"
                        }
                    }
                }
            },
            "StoreMetrics": {
                "type": "object",
                "properties": {
                    "total_sales": {
                        "type": "integer"
                    },
                    "total_orders": {
                        "type": "integer"
                    },
                    "total_customers": {
                        "type": "integer"
                    },
                    "low_stock_count": {
                        "type": "integer"
                    },
                    "out_of_stock_count": {
                        "type": "integer"
                    }
                }
            },
            "ProblemDetails": {
                "type": "object",
                "required": [
                    "type",
                    "title",
                    "status",
                    "detail"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "format": "uri"
                    },
                    "title": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "detail": {
                        "type": "string"
                    },
                    "instance": {
                        "type": "string",
                        "format": "uri"
                    }
                }
            },
            "ProductListResponse": {
                "type": "object",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Product"
                        }
                    },
                    "total": {
                        "type": "integer"
                    },
                    "page": {
                        "type": "integer"
                    },
                    "limit": {
                        "type": "integer"
                    },
                    "per_page": {
                        "type": "integer"
                    }
                }
            },
            "ProductInput": {
                "type": "object",
                "required": [
                    "name",
                    "price"
                ],
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "price": {
                        "type": "integer",
                        "description": "Minor cents"
                    },
                    "sku": {
                        "type": "string"
                    },
                    "stock_quantity": {
                        "type": "integer"
                    }
                }
            },
            "ProductUpdateInput": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "price": {
                        "type": "integer"
                    },
                    "stock_quantity": {
                        "type": "integer"
                    },
                    "description": {
                        "type": "string"
                    }
                }
            },
            "CategoryListResponse": {
                "type": "object",
                "properties": {
                    "data": {
